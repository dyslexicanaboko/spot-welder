using Newtonsoft.Json;

namespace Namespace1
{
    public partial class SerializationService
    {
        public string ToJson(IEnumerable<DataTypeTestEntity> input) => JsonConvert.SerializeObject(input);

        public IEnumerable<DataTypeTestEntity> FromJson(string json) => JsonConvert.DeserializeObject<IEnumerable<DataTypeTestEntity>>(json);
    }
