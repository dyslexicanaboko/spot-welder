        public int Insert(DataTypeTestEntity entity)
        {
            const string sql = @"INSERT INTO dbo.DataTypeTest (
                Int64,
                ByteArray_Binary,
                Boolean,
                String_Char,
                DateTime_Date,
                DateTime_DateTime,
                DateTime_DateTime2,
                DateTimeOffset,
                Decimal_Decimal,
                Double,
                Int32,
                Decimal_Money,
                String_NChar,
                Decimal_Numeric,
                String_NVarchar,
                Single,
                ByteArray_RowVersion,
                DateTime_SmallDateTime,
                Int16,
                Decimal_SmallMoney,
                TimeSpan,
                Byte,
                Guid,
                ByteArray_VarBinary,
                String,
                Xml
						) VALUES (
                @Int64,
                @ByteArray_Binary,
                @Boolean,
                @String_Char,
                @DateTime_Date,
                @DateTime_DateTime,
                @DateTime_DateTime2,
                @DateTimeOffset,
                @Decimal_Decimal,
                @Double,
                @Int32,
                @Decimal_Money,
                @String_NChar,
                @Decimal_Numeric,
                @String_NVarchar,
                @Single,
                @ByteArray_RowVersion,
                @DateTime_SmallDateTime,
                @Int16,
                @Decimal_SmallMoney,
                @TimeSpan,
                @Byte,
                @Guid,
                @ByteArray_VarBinary,
                @String,
                @Xml)	
SELECT SCOPE_IDENTITY() AS PK;";

            using var connection = new SqlConnection(ConnectionString);

            var p = new DynamicParameters();
            p.Add(name: "@Int64", dbType: DbType.Int64, value: entity.Int64);
            p.Add(name: "@ByteArray_Binary", dbType: DbType.Binary, value: entity.ByteArrayBinary);
            p.Add(name: "@Boolean", dbType: DbType.Boolean, value: entity.Boolean);
            p.Add(name: "@String_Char", dbType: DbType.AnsiStringFixedLength, value: entity.StringChar, size: 1);
            p.Add(name: "@DateTime_Date", dbType: DbType.Date, value: entity.DateTimeDate);
            p.Add(name: "@DateTime_DateTime", dbType: DbType.DateTime, value: entity.DateTimeDateTime);
            p.Add(name: "@DateTime_DateTime2", dbType: DbType.DateTime2, value: entity.DateTimeDateTime2, scale: 0);
            p.Add(name: "@DateTimeOffset", dbType: DbType.DateTimeOffset, value: entity.DateTimeOffset);
            p.Add(name: "@Decimal_Decimal", dbType: DbType.Decimal, value: entity.DecimalDecimal, precision: 4, scale: 2);
            p.Add(name: "@Double", dbType: DbType.Double, value: entity.Double);
            p.Add(name: "@Int32", dbType: DbType.Int32, value: entity.Int32);
            p.Add(name: "@Decimal_Money", dbType: DbType.Currency, value: entity.DecimalMoney);
            p.Add(name: "@String_NChar", dbType: DbType.StringFixedLength, value: entity.StringNChar, size: 1);
            p.Add(name: "@Decimal_Numeric", dbType: DbType.Decimal, value: entity.DecimalNumeric, precision: 4, scale: 2);
            p.Add(name: "@String_NVarchar", dbType: DbType.String, value: entity.StringNVarchar, size: 10);
            p.Add(name: "@Single", dbType: DbType.Single, value: entity.Single);
            p.Add(name: "@ByteArray_RowVersion", dbType: DbType.Object, value: entity.ByteArrayRowVersion);
            p.Add(name: "@DateTime_SmallDateTime", dbType: DbType.DateTime, value: entity.DateTimeSmallDateTime);
            p.Add(name: "@Int16", dbType: DbType.Int16, value: entity.Int16);
            p.Add(name: "@Decimal_SmallMoney", dbType: DbType.Currency, value: entity.DecimalSmallMoney);
            p.Add(name: "@TimeSpan", dbType: DbType.Time, value: entity.TimeSpan);
            p.Add(name: "@Byte", dbType: DbType.Byte, value: entity.Byte);
            p.Add(name: "@Guid", dbType: DbType.Guid, value: entity.Guid);
            p.Add(name: "@ByteArray_VarBinary", dbType: DbType.Binary, value: entity.ByteArrayVarBinary);
            p.Add(name: "@String", dbType: DbType.AnsiString, value: entity.String, size: 10);
            p.Add(name: "@Xml", dbType: DbType.Xml, value: entity.Xml);

            return connection.ExecuteScalar<int>(sql, p);
        }

