        public void Delete(int dataTypeTestId)
        {
            const string sql = "DELETE FROM dbo.DataTypeTest WHERE DataTypeTestId = @DataTypeTestId";

            using var connection = new SqlConnection(ConnectionString);

            connection.Execute(sql, GetPrimaryKeyParameter(dataTypeTestId));
        }

        private DynamicParameters GetPrimaryKeyParameter(int dataTypeTestId)
        {
            var p = new DynamicParameters();
            p.Add(name: "@DataTypeTestId", dbType: DbType.Int32, value: dataTypeTestId);

