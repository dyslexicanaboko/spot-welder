        public DataTypeTestEntity? Select(int dataTypeTestId)
        {
            const string sql = @"
			SELECT
	                DataTypeTestId,
                Int64,
                ByteArray_Binary,
                Boolean,
                String_Char,
                DateTime_Date,
                DateTime_DateTime,
                DateTime_DateTime2,
                DateTimeOffset,
                Decimal_Decimal,
                Double,
                Int32,
                Decimal_Money,
                String_NChar,
                Decimal_Numeric,
                String_NVarchar,
                Single,
                ByteArray_RowVersion,
                DateTime_SmallDateTime,
                Int16,
                Decimal_SmallMoney,
                TimeSpan,
                Byte,
                Guid,
                ByteArray_VarBinary,
                String,
                Xml
			FROM dbo.DataTypeTest
			WHERE DataTypeTestId = @DataTypeTestId";

            using var connection = new SqlConnection(ConnectionString);

            var lst = connection.Query<DataTypeTestEntity>(sql, GetPrimaryKeyParameter(dataTypeTestId)).ToList();

            return lst.SingleOrDefault();
        }

